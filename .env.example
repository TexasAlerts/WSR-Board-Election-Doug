# ==============================================
# Doug Charles Campaign Website - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ==============================================
# SUPABASE (Required)
# ==============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================
# EMAIL - RESEND (Required for email functionality)
# ==============================================
RESEND_API_KEY=re_xxxxxxxxxxxx
# IMPORTANT: Use a real, monitored email address (NOT noreply@)
# This improves deliverability and shows you want engagement
SMTP_FROM=Doug Charles <hello@dougcharles.com>
NOTIFY_EMAIL=hello@dougcharles.com
ADMIN_EMAIL=doug@dougcharles.com

# ==============================================
# SMS - TELNYX (Required for phone verification)
# ==============================================
TELNYX_API_KEY=KEY_xxxxxxxxxxxxxxxx
TELNYX_PHONE_NUMBER=+19725551234
TELNYX_CAMPAIGN_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TELNYX_TCR_ID=XXXXXXX
# Telnyx webhook public key for ED25519 signature verification
# Get this from Telnyx Portal > Inbound Settings > Webhook Signing
TELNYX_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYour Telnyx ED25519 public key here\n-----END PUBLIC KEY-----"

# ==============================================
# ADMIN ACCESS (Required)
# ==============================================
ADMIN_PASSWORD=your-secure-admin-password

# ==============================================
# SITE CONFIGURATION
# ==============================================
NEXT_PUBLIC_SITE_URL=https://www.dougcharles.com
SITE_URL=https://www.dougcharles.com

# ==============================================
# SESSION CONFIGURATION (Optional - has defaults)
# ==============================================
SESSION_EXPIRY_HOURS=48
VERIFICATION_EXPIRY_HOURS=24
SMS_CODE_EXPIRY_MINUTES=10

# ==============================================
# GOOGLE RECAPTCHA v3 (Required for spam protection)
# ==============================================
# Get your keys from: https://www.google.com/recaptcha/admin
# Public key - visible on client side
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Secret key - server side only (NEVER expose to client)
RECAPTCHA_SECRET_KEY=6LeXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Score threshold (0.0-1.0). Higher = stricter. Recommended: 0.5
RECAPTCHA_SCORE_THRESHOLD=0.5

# ==============================================
# USPS ADDRESS VALIDATION (Optional)
# ==============================================
USPS_USER_ID=your-usps-user-id
